{
  "name": "json-analyze",
  "version": "2.8.0",
  "type": "module",
  "main": "src/index.ts",
  "bin": "bin/json-analyze",
  "description": "JSON Schema Analyzer - 将任意 JSON 转换为扁平化 schema 数组",
  "license": "MIT",
  "author": "waterwu <boatwind@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/watert/json-analyze.git" },
  "homepage": "https://github.com/watert/json-analyze#readme",
  "keywords": ["json", "schema", "analyzer", "jsonl", "cli", "bun"],
  "engines": { "bun": ">=1.2.0" },
  "files": ["bin", "src", "skills", "!**/*.test.ts"],
  "scripts": {
    "check": "bunx tsc --noEmit --project tsconfig.json",
    "test": "bunx vitest run --watch=false",
    "test:watch": "bunx vitest",
    "test:node": "npx vitest run --watch=false",
    "start": "bun -i src/index.ts"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.10.0",
    "vitest": "^3.0.5"
  }
}